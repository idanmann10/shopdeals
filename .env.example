# --- Core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (Postgres) ---
DATABASE_URL=postgres://user:pass@localhost:5432/shopdeals

# --- Auth (Clerk; optional, only if you front the MCP with auth) ---
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# --- Source: FMTC ---
FMTC_API_KEY=
FMTC_BASE_URL=https://s3.fmtc.co/api/v3/

# --- Source: Awin ---
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# --- Source: Impact ---
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# --- Source: Keepa (Amazon price history; gated) ---
KEEPA_API_KEY=

# --- Embeddings (Voyage AI for pgvector dedup) ---
VOYAGE_API_KEY=

# --- Affiliate tagging ---
# Amazon Associates tag. When set, every amazon.com URL we return is wrapped
# with `?tag=<value>`. Free + instant signup at affiliate-program.amazon.com.
AMAZON_ASSOCIATES_TAG=

# Skimlinks publisher id. When set, every non-Amazon merchant URL is wrapped
# through Skimlinks for universal monetization. Free signup at skimlinks.com.
SKIMLINKS_PUBLISHER_ID=

# --- Source: CouponAPI.org (paid; free 7-day trial) ---
COUPONAPI_KEY=
# Optional: override base URL or scope to a country, e.g. US/UK.
# COUPONAPI_BASE_URL=https://couponapi.org/api/v2
# COUPONAPI_COUNTRY=US

# --- Live shopping search (SerpApi Google Shopping) ---
# Powers the `find_products` MCP tool. 250 free searches/month, $25/mo for 1k.
SERPAPI_KEY=

# --- MCP server ---
MCP_PUBLIC_URL=https://mcp.shopdeals.sh
MCP_OAUTH_ISSUER=https://mcp.shopdeals.sh
